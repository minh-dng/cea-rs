FloatArray = NDArray[np.float64]
VectorLike = Sequence[float] | FloatArray
__version__: str
__all__: list[str]

class Reactant:
    name: str
    formula: dict[str, float] | None
    molecular_weight: float | None
    enthalpy: float | None
    enthalpy_units: str | None
    temperature: float | None

    def __init__(
        self,
        name: str,
        formula: dict[str, float] | None = None,
        molecular_weight: float | None = None,
        enthalpy: float | None = None,
        enthalpy_units: str | None = None,
        temperature: float | None = None,
    ) -> None: ...
    def get_valid_temperature_range(self) -> tuple[float, float]: ...

class Mixture:
    num_species: int

    def __init__(
        self,
        species: list[str | Reactant] | None = None,
        products_from_reactants: bool = False,
        omit: list[str] = [],
        ions: bool = False,
    ) -> None: ...
    def calc_property(
        self,
        prop_type: int,
        weights: VectorLike,
        temperature: float | VectorLike,
        pressure: float | None = None,
    ) -> float: ...
    def chem_eq_ratio_to_of_ratio(
        self,
        oxidant_weights: VectorLike,
        fuel_weights: VectorLike,
        chem_eq_ratio: float,
    ) -> float: ...
    def moles_to_weights(self, moles: VectorLike) -> FloatArray: ...
    def of_ratio_to_weights(
        self, oxidant_weights: VectorLike, fuel_weights: VectorLike, of_ratio: float
    ) -> FloatArray: ...
    def weight_eq_ratio_to_of_ratio(
        self,
        oxidant_weights: VectorLike,
        fuel_weights: VectorLike,
        weight_eq_ratio: float,
    ) -> float: ...
    def weights_to_moles(self, weights: VectorLike) -> FloatArray: ...
    @property
    def species_names(self) -> list[str]: ...

class EqSolver:
    def __init__(
        self,
